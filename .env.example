# Copiaza in .env si completeaza.
DATABASE_URL="postgresql://user:parola@localhost:5432/devizor?schema=public"

# Secret pentru semnarea cookie-ului de sesiune. Genereaza cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Cheie API Anthropic (https://console.anthropic.com) pentru generarea cu AI.
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------
# Preturi de referinta (optional)
# ------------------------------------------------------------------
# Fara ele aplicatia merge intreaga: catalogul se umple din liste de preturi
# sau de mana, iar importul automat e doar indisponibil.
#
# API-ul de materiale, interogat ca `GET {URL}?page=1`, trebuie sa raspunda:
#   { "items": [ { "name": "Ciment CEM II 42,5R 40 kg", "unit": "sac",
#                  "price": 26.5, "county": "RO-CJ", "observedAt": "2026-08-28",
#                  "supplier": "...", "url": "https://..." } ],
#     "nextPage": 2 }
# `county`, `observedAt`, `supplier` si `url` sunt optionale; fara `county`
# pretul e national. Vezi lib/materials/api-source.ts.
PRETURI_API_URL=""
PRETURI_API_KEY=""
PRETURI_API_NUME=""

# API-ul de manopera, interogat ca `GET {URL}`, trebuie sa raspunda:
#   { "period": "2026-06-01", "national": 42.5,
#     "counties": [ { "county": "RO-CJ", "index": 1.04 } ] }
# `index` e raportul fata de media nationala (1.0 = media); alternativ `value`
# in lei/ora, si atunci `national` e obligatoriu. Vezi lib/materials/labor-source.ts.
MANOPERA_API_URL=""
MANOPERA_API_KEY=""
MANOPERA_API_NUME=""

# ------------------------------------------------------------------
# Preturi luate direct de la magazin (optional)
# ------------------------------------------------------------------
# Cand cineva cauta un material si catalogul n-are nimic pentru el, sau are ceva
# mai vechi decat SCRAPER_TTL_ORE, aplicatia cere pagina de cautare a magazinului
# si scrie ce gaseste. Implicit oprit: pornirea e o decizie, nu un efect
# secundar al unui deploy.
#
# Inainte sa pornesti: scraping-ul unui magazin poate intra in conflict cu
# termenii lui de utilizare. Calea sanctionata pentru preturi e feed-ul de
# produse din programul lui de afiliere. Codul respecta robots.txt, tine ritm si
# se prezinta, dar decizia e a ta.
SCRAPER_ACTIV="false"
SCRAPER_TTL_ORE="24"
SCRAPER_UA="Devizor/1.0 (+adresa ta de contact)"
SCRAPER_PAUZA_MS="2000"
SCRAPER_TIMEOUT_MS="8000"
SCRAPER_CACHE_MS="900000"

# Magazinele din care se citeste, pe cheie, separate prin virgula. Nesetata
# inseamna toate. Exista ca sa se poata scoate un magazin din trecere fara
# deploy: de pilda Leroy, cat timp nu se stie daca raspunde de pe serverul tau.
SCRAPER_MAGAZINE="dedeman,hornbach,leroymerlin,brico"

# Magazinele la care se trece peste `robots.txt`, pe cheie. Purtarea implicita e
# sa se respecte, si asa rimine pentru orice magazin nou. Suprascrie cimpul
# `robots` din configurarea site-ului, in ambele sensuri.
#
# Nu porneste nimic altceva: User-Agent-ul rimine cel care spune cine sintem,
# ritmul si timeout-ul rimin, si nu exista reluare pe alt IP. A nu citi un fisier
# de convenție e o hotarire de risc pe deploy-ul tau; a te da drept altcineva ca
# sa treci de un zid e altceva, si codul nu o face.
SCRAPER_IGNORA_ROBOTS="dedeman"

# Rularea zilnica: citi termeni intr-o trecere, si oprirea dupa ceas. Bugetul
# exista ca functia sa se termine inaintea limitei platformei. Ce nu intra revine
# maine, fiindca ordinea e cel-mai-vechi-intii, deci nu se pierde nimic.
SCRAPER_SCAN_TERMENI="40"
SCRAPER_SCAN_BUGET_MS="240000"

# Fereastra in care doua preturi de la doua magazine se mai pot compara, in zile.
# Fara ea s-ar pune un pret de acum sase luni langa unul de azi si s-ar numi
# comparatie de piata.
SCRAPER_FEREASTRA_ZILE="7"

# ------------------------------------------------------------------
# Rularea zilnica prin Vercel Cron (optional)
# ------------------------------------------------------------------
# Programul e in `vercel.json`. Ruta porneste cereri catre site-uri strine de pe
# serverul tau, deci e pazita: fara secretul asta setat, `/api/cron/preturi`
# raspunde 404 si nu exista. Vercel trimite antetul singur la rutele din `crons`.
# Aceeasi treaba se face si de la linia de comanda, cu `npm run preturi:zilnic`.
CRON_SECRET=""
