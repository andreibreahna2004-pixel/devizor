# Copiaza in .env si completeaza.
DATABASE_URL="postgresql://user:parola@localhost:5432/devizor?schema=public"

# Secret pentru semnarea cookie-ului de sesiune. Genereaza cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Cheie API Anthropic (https://console.anthropic.com) pentru generarea cu AI.
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------
# Preturi de referinta (optional)
# ------------------------------------------------------------------
# Fara ele aplicatia merge intreaga: catalogul se umple din liste de preturi
# sau de mana, iar importul automat e doar indisponibil.
#
# API-ul de materiale, interogat ca `GET {URL}?page=1`, trebuie sa raspunda:
#   { "items": [ { "name": "Ciment CEM II 42,5R 40 kg", "unit": "sac",
#                  "price": 26.5, "county": "RO-CJ", "observedAt": "2026-08-28",
#                  "supplier": "...", "url": "https://..." } ],
#     "nextPage": 2 }
# `county`, `observedAt`, `supplier` si `url` sunt optionale; fara `county`
# pretul e national. Vezi lib/materials/api-source.ts.
PRETURI_API_URL=""
PRETURI_API_KEY=""
PRETURI_API_NUME=""

# API-ul de manopera, interogat ca `GET {URL}`, trebuie sa raspunda:
#   { "period": "2026-06-01", "national": 42.5,
#     "counties": [ { "county": "RO-CJ", "index": 1.04 } ] }
# `index` e raportul fata de media nationala (1.0 = media); alternativ `value`
# in lei/ora, si atunci `national` e obligatoriu. Vezi lib/materials/labor-source.ts.
MANOPERA_API_URL=""
MANOPERA_API_KEY=""
MANOPERA_API_NUME=""

# ------------------------------------------------------------------
# Preturi luate direct de la magazin (optional)
# ------------------------------------------------------------------
# Cand cineva cauta un material si catalogul n-are nimic pentru el, sau are ceva
# mai vechi decat SCRAPER_TTL_ORE, aplicatia cere pagina de cautare a magazinelor
# si scrie ce gaseste. Implicit oprit: pornirea e o decizie, nu un efect
# secundar al unui deploy.
#
# Inainte sa pornesti: scraping-ul unui magazin poate intra in conflict cu
# termenii lui de utilizare. Calea sanctionata pentru preturi e feed-ul de
# produse din programul lui de afiliere. Codul respecta robots.txt, tine ritm si
# se prezinta, dar decizia e a ta.
SCRAPER_ACTIV="false"
SCRAPER_TTL_ORE="24"
SCRAPER_UA="Devizor/1.0 (+adresa ta de contact)"
SCRAPER_PAUZA_MS="2000"
SCRAPER_TIMEOUT_MS="8000"
SCRAPER_CACHE_MS="900000"

# Magazinele intrebate, in ordine. Nesetata inseamna toate patru: aplicatia merge
# din cutie, fara configurare per instalare. Variabila exista ca sa poti opri un
# magazin — din motive de termeni de utilizare, sau fiindca nu da nimic.
#   dedeman, leroymerlin, hornbach, bricostore
SCRAPER_MAGAZINE=""

# Un magazin care da zero de trei ori la rand e lasat in pace atata timp. Fara
# racire, un magazin stricat ar costa la fiecare cautare o pagina, un timeout si
# un apel de model.
SCRAPER_RACIRE_MS="21600000"

# Adresa de cautare a unui magazin, cand si-o muta. `{q}` e interogarea. Ventilul
# prin care se repara fara sa astepti o versiune noua:
#   SCRAPER_URL_HORNBACH="https://www.hornbach.ro/s/{q}"

# ------------------------------------------------------------------
# Citirea paginii cu modelul (optional)
# ------------------------------------------------------------------
# Cand niciun strat determinist n-a prins — nici JSON-LD, nici microdate, nici
# starea din pagina, nici tiparele — pagina o citeste Claude, cu ANTHROPIC_API_KEY
# de mai sus. Costa: ~15k tokeni de intrare per magazin, o singura data. Modelul
# intoarce si selectoarele prin care a gasit produsele; alea se salveaza, si de la
# a doua cautare magazinul se citeste gratuit, pana la urmatorul redesign.
#
# Fara cheie stratul nu exista si cautarea merge mai departe cu ce e determinist.
# "false" il opreste chiar si cu cheia pusa.
SCRAPER_AI="true"
SCRAPER_AI_MAX_CARACTERE="60000"
