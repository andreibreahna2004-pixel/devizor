{
  "name": "devizor",
  "version": "0.1.0",
  "private": true,
  "description": "Devize si facturi cu AI pentru firme de constructii din Romania",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "demo:deviz": "tsx scripts/demo-deviz.ts",
    "demo:istoric": "tsx scripts/demo-istoric.ts",
    "demo:factura": "node --conditions=react-server --import tsx scripts/demo-factura.ts",
    "demo:materiale": "tsx scripts/seed-materiale.ts",
    "dev:token": "tsx scripts/dev-token.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^6.19.0",
    "@react-pdf/renderer": "^4.3.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.0",
    "fast-xml-parser": "^5.10.1",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
